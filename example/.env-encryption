# Path to this project's age identity (not a secret — the key file is).
# Create with: age-keygen -pq -o ~/.config/envro/example.key
ENVRO_AGE_IDENTITY_FILE=~/.config/envro/example.key

PG_HOST=localhost

# Replace with ciphertext from encrypting a password (≥6 chars) to your age1pq1…:
#   envro::encrypt_value("s3cr3t", &[recipient])  or  age/rage CLI + Encrypted[AGE:b64:…] wrap
PG_PASS=Encrypted[AGE:b64:REPLACE_ME]

DATABASE_URI=pg://app:${PG_PASS}@${PG_HOST}/app
