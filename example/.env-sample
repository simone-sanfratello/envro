# Decompose connection knobs, compose the DSN with ${VAR}.
# Order does not matter — DATABASE_URI can sit above or below its parts.

PG_USER=app
PG_PASS=secret
PG_HOST=db.example.com
PG_PORT=5432
PG_DB=mydb
PG_SSLMODE=require

DATABASE_URI=pg://${PG_USER}:${PG_PASS}@${PG_HOST}:${PG_PORT}/${PG_DB}?sslmode=${PG_SSLMODE}

DB_POOL_SIZE=32
